# Salpakan server environment
PORT=3001

# Neon PostgreSQL (leave unset for local in-memory mode)
DATABASE_URL=postgres://user:pass@ep-xyz.neon.tech/neondb?sslmode=require

# High-entropy secret — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Comma-separated allowed origins for CORS + Socket.io.
# No trailing slash — CORS compares this against the browser's Origin header,
# which is always bare (e.g. https://your-site.netlify.app).
CLIENT_ORIGIN=http://localhost:5173

# Per-turn countdown in seconds (on expiry a random legal move is auto-played)
TURN_SECONDS=60
